# Copy to .env only if your shell or launcher loads it. Do not commit .env.
FIELDTECH_HOST=127.0.0.1
FIELDTECH_PORT=8765
FIELDTECH_DATA_DIR=./data

# "mock" demonstrates the workflow. "ollama" and "llama_cpp" call local runtimes.
FIELDTECH_MODEL_PROVIDER=mock
FIELDTECH_MODEL_BASE_URL=http://127.0.0.1:11434
FIELDTECH_MODEL_NAME=qwen3:8b
# Optional bearer token for a protected llama.cpp server.
FIELDTECH_MODEL_API_KEY=
FIELDTECH_MODEL_TIMEOUT_SECONDS=120
FIELDTECH_MODEL_REASONING_EFFORT=medium

# Only bind to localhost. The MVP has no authentication or network hardening.
FIELDTECH_ALLOW_REMOTE=false
